# ---- Lumen Deck 环境变量 ----
# 复制为 .env.local 并按需修改。所有变量都有开发默认值，仅 LUMEN_SECRET_KEY 生产必填。

# API 端口
LUMEN_PORT=8787
# web / admin 端口
LUMEN_WEB_PORT=5273
LUMEN_ADMIN_PORT=5274

# 主密钥：Key 加密 + JWT 签名。32 字节以上。生产必须覆盖。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LUMEN_SECRET_KEY=

# 覆盖默认 admin 密码（默认 admin/admin）
LUMEN_ADMIN_PASSWORD=admin

# 内置管理员首次登录是否强制改密。
# 留空 = 生产强制、开发不强制。想固定行为就显式写 true / false。
LUMEN_ADMIN_FORCE_PASSWORD_CHANGE=

# 是否开放自助注册
LUMEN_ALLOW_SELF_SIGNUP=true

# 运行时数据目录（db / 对象存储 / 导出产物）
LUMEN_DATA_DIR=./data

# 全局任务并发上限
LUMEN_MAX_CONCURRENCY=6
# 任务租约时长（毫秒）
LUMEN_QUEUE_LEASE_MS=60000

# 对外访问基址（分享链接、导出回链使用）
LUMEN_PUBLIC_BASE_URL=http://localhost:8787
