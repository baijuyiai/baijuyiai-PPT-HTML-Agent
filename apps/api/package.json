{
  "name": "@lumen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"../../packages/stock-library/assets/**\" src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "tsx -e \"import('./src/index.js')\""
  },
  "dependencies": {
    "@lumen/ir-schema": "workspace:*",
    "@lumen/provider-gateway": "workspace:*",
    "@lumen/server-core": "workspace:*",
    "@lumen/stock-library": "workspace:*",
    "@lumen/style-engine": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "typescript": "^5.7.2"
  }
}
